{
  "name": "drivemind",
  "private": true,
  "workspaces": [
    "mobile",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:backend dev:mobile",
    "dev:mobile": "npm --workspace mobile run start",
    "dev:backend": "npm --workspace backend run dev",
    "lint": "npm-run-all -p lint:mobile lint:backend",
    "lint:mobile": "npm --workspace mobile run lint",
    "lint:backend": "npm --workspace backend run lint"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.84.1",
    "eslint": "^10.1.0",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "expo": "~55.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-web": "^0.21.0"
  },
  "main": "mobile/index.js",
  "overrides": {},
  "version": "1.0.0"
}
