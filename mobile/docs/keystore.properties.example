# Copy to mobile/android/keystore.properties (gitignored).
# NEVER commit keystore.properties or *.keystore / *.jks.
#
# Play upload key (SHA-1 7F:C9:1F:8A:…): use drivemind-release.keystore
#   Copy keystore → mobile/android/app/drivemind-release.keystore
#   Fill storePassword / keyAlias / keyPassword from your backup keystore.properties
#
# EAS keystore (SHA-1 34:1E:CE:65:…) is a DIFFERENT key — do not use for Play upload
# unless you reset the upload key in Play Console.
#
# Verify before upload:
#   npm run android:verify-keystore

storeFile=drivemind-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=drivemind-release
keyPassword=YOUR_KEY_PASSWORD
