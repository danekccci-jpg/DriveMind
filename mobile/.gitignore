# --- DEPENDENCIES ---
node_modules/
.pnp
*.pnp.js
mobile/node_modules/

# --- ANDROID (CRITICAL: Source is kept, Junk is ignored) ---
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/.idea/
mobile/android/local.properties
mobile/android/*.iml
mobile/android/GeneratedPluginRegistrant.java
mobile/android/.cxx/
mobile/android/.externalNativeBuild/

# --- IOS ---
mobile/ios/build/
mobile/ios/Pods/
mobile/ios/DerivedData/
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/*.xcodeproj/xcuserdata/
mobile/ios/*.xcodeproj/project.xcworkspace/
mobile/ios/.lsan/

# --- SECURITY & KEYS (NEVER COMMIT THESE) ---
*.jks
*.keystore
*.p12
*.key
*.pem
*.p8
*.mobileprovision
.env
.env.local
.env.production
.env.staging
mobile/.env*

# --- METRO & BUNDLERS ---
.expo/
dist/
web-build/
.metro-health-check*
*.tsbuildinfo

# --- SYSTEM FILES ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- DEBUG & LOGS ---
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.pnpm-debug.log*

# --- NEXT.JS / WEB (If applicable) ---
.next/
out/
.vercel