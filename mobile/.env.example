# Copy to `.env` and fill in values. Required for local dev and EAS Build (set same keys in EAS Secrets).
# Run release builds with NODE_ENV=production so Expo loads `.env` / `.env.production`.
#
# @see mobile/app.config.js

# --- Google Play Billing (react-native-iap) ---
# Override via EAS / .env if Play Console product id differs from default.
# EXPO_PUBLIC_SUBSCRIPTION_SKU=drivemind_weekly_premium
EXPO_PUBLIC_BACKEND_URL=

# --- Google Maps Platform (Maps SDK + Directions / Geocoding REST) ---
# Prefer EXPO_PUBLIC_GOOGLE_MAPS_API_KEY; EXPO_PUBLIC_GOOGLE_MAPS_KEY is a legacy alias.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Optional: server-side Directions proxy (if used instead of direct Google REST calls).
EXPO_PUBLIC_DIRECTIONS_PROXY_URL=

# --- Google Sign-In (OAuth Web client ID, client_type 3) ---
# Must match oauth_client in android/app/google-services.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Firebase (client SDK — protect data with Firestore Security Rules) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Data Connect (optional overrides; defaults: drivemind / default / europe-central2) ---
EXPO_PUBLIC_DATA_CONNECT_SERVICE_ID=
EXPO_PUBLIC_DATA_CONNECT_CONNECTOR_ID=
EXPO_PUBLIC_DATA_CONNECT_LOCATION=

# --- Admin QA tools (local only — comma-separated, never commit real values) ---
EXPO_PUBLIC_ADMIN_EMAILS=
EXPO_PUBLIC_ADMIN_PUBLIC_IDS=
