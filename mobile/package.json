{
  "name": "mobile",
  "version": "1.0.13",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node ./scripts/patch-metro-multipart.js",
    "start": "expo start --dev-client",
    "start:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-fresh.ps1 -Start",
    "start:fresh": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-fresh.ps1 -Start -Fresh",
    "start:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-fresh.ps1 -Start -Fresh",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-fresh.ps1 -CleanOnly",
    "dev:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-fresh.ps1 -Start -Rebuild",
    "dev:open": "adb shell am start -n com.guessxx.drivemind/.MainActivity",
    "dev:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-fresh.ps1 -Start -ResetApp",
    "android": "expo run:android",
    "android:release": "cross-env NODE_ENV=production expo run:android --variant release",
    "android:release:fresh": "node ./scripts/clean-android-artifacts.js && cross-env NODE_ENV=production expo run:android --variant release --no-build-cache",
    "android:clean:artifacts": "node ./scripts/clean-android-artifacts.js",
    "icons:android": "node ./scripts/generate-android-launcher-icons.mjs",
    "android:google-services": "node ./scripts/ensure-google-services-json.js",
    "android:logcat-clear": "powershell -ExecutionPolicy Bypass -File ./scripts/clear-logcat.ps1",
    "android:crash-log": "powershell -ExecutionPolicy Bypass -File ./scripts/capture-release-crash-log.ps1",
    "android:install-release": "powershell -ExecutionPolicy Bypass -File ./scripts/install-release-apk.ps1",
    "android:verify-keystore": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-upload-keystore.ps1",
    "android:verify-release-env": "cross-env NODE_ENV=production powershell -ExecutionPolicy Bypass -File ./scripts/verify-release-env.ps1",
    "android:verify-r8": "node ./scripts/verify-r8-config.js",
    "android:bundle:release": "cross-env NODE_ENV=production powershell -ExecutionPolicy Bypass -Command \"Set-Location android; .\\gradlew bundleRelease\"",
    "android:bundle:release:fresh": "cross-env NODE_ENV=production powershell -ExecutionPolicy Bypass -File ./scripts/build-aab-fresh.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@drivemind/shared": "^0.0.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.15.7",
    "@react-navigation/native": "^7.2.0",
    "@react-navigation/native-stack": "^7.14.10",
    "@react-navigation/stack": "^7.8.10",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.27",
    "expo-av": "^16.0.8",
    "expo-blur": "~55.0.15",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-localization": "~55.0.16",
    "expo-location": "~55.1.11",
    "expo-modules-core": "~55.0.25",
    "expo-notifications": "~55.0.24",
    "expo-secure-store": "~55.0.15",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.19",
    "expo-task-manager": "~55.0.17",
    "firebase": "^11.10.0",
    "react": "19.2.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.83.6",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-iap": "npm:@iaptic/react-native-iap@13.0.2",
    "react-native-maps": "1.27.2",
    "react-native-permissions": "^5.5.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "cross-env": "^7.0.3",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
