{
  "expo": {
    "name": "DriveMind",
    "slug": "drivemind",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo/logo-symbol-light.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08101C"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      },
      "config": {
        "googleMapsApiKey": "REDACTED_GOOGLE_MAPS_KEY"
      }
    },
    "android": {
      "package": "com.guessxx.drivemind",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo-symbol-light.png",
        "backgroundColor": "#F5F5F7"
      },
      "config": {
        "googleMaps": {
          "apiKey": "REDACTED_GOOGLE_MAPS_KEY"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withDriveMindNative",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DriveMind needs your location for navigation and dispatch.",
          "locationAlwaysAndWhenInUsePermission": "DriveMind uses your location in the background during active navigation.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.389029600639-bn15t2ltvor8u2rcgbb4sdm8bs565ec8"
        }
      ]
    ],
    "extra": {
      "backendUrl": "",
      "googleMapsApiKey": "REDACTED_GOOGLE_MAPS_KEY",
      "firebase": {
        "apiKey": "REDACTED_FIREBASE_API_KEY",
        "authDomain": "drivemind-d4994.firebaseapp.com",
        "projectId": "drivemind-d4994",
        "storageBucket": "drivemind-d4994.firebasestorage.app",
        "messagingSenderId": "389029600639",
        "appId": "1:389029600639:android:7636d1bd1e8117dbbdce4a"
      },
      "dataConnect": {
        "serviceId": "drivemind",
        "connectorId": "default",
        "location": "europe-central2"
      },
      "eas": {
        "projectId": "0e7f5b9f-e8df-4452-9734-a1389b746d94"
      }
    }
  }
}
