{
  "expo": {
    "name": "DriveMind",
    "slug": "drivemind",
    "version": "1.0.43",
    "orientation": "portrait",
    "icon": "./assets/logo/logo-symbol-light.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08101C"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.guessxx.drivemind",
      "versionCode": 43,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo-symbol-light.png",
        "backgroundColor": "#F5F5F7"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withDriveMindNative",
      "./plugins/withDriveMindIcons",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DriveMind needs your location for navigation and dispatch.",
          "locationAlwaysAndWhenInUsePermission": "DriveMind uses your location in the background during active navigation.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-localization",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "dataConnect": {
        "serviceId": "drivemind",
        "connectorId": "default",
        "location": "europe-central2"
      },
      "eas": {
        "projectId": "0e7f5b9f-e8df-4452-9734-a1389b746d94"
      }
    }
  }
}
