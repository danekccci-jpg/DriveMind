{
  "expo": {
    "name": "DriveMind",
    "slug": "drivemind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      },
      "config": {
        "googleMapsApiKey": "REDACTED_GOOGLE_MAPS_KEY"
      }
    },
    "android": {
      "package": "com.guessxx.drivemind",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "config": {
        "googleMaps": {
          "apiKey": "REDACTED_GOOGLE_MAPS_KEY"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DriveMind needs your location for navigation and dispatch.",
          "locationAlwaysAndWhenInUsePermission": "DriveMind uses your location in the background during active navigation.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.981872670341-ddggrmam043qm34b1rqgtahn38bpbual"
        }
      ]
    ],
    "extra": {
      "backendUrl": "",
      "googleMapsApiKey": "REDACTED_GOOGLE_MAPS_KEY",
      "eas": {
        "projectId": "0e7f5b9f-e8df-4452-9734-a1389b746d94"
      }
    }
  }
}
